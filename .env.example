# Resume Roaster Docker Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: Database password (use a strong random password)
POSTGRES_PASSWORD=your_secure_password_here

# REQUIRED: Groq API key for LLM
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED: Secret key for backend (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Optional: Database settings
POSTGRES_USER=roaster
POSTGRES_DB=resume_roaster

# Optional: LLM model
GROQ_MODEL=llama-3.1-70b-versatile

# Optional: CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Optional: Frontend API URL
VITE_API_URL=http://localhost:8000
