# Resume Roaster Backend Environment Variables
# Copy this file to .env and fill in the values

# REQUIRED: Groq API key for LLM
GROQ_API_KEY=your_groq_api_key_here

# REQUIRED: Secret key for sessions/CSRF (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# Database (required in production)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resume_roaster

# Optional: LLM model
GROQ_MODEL=llama-3.1-70b-versatile

# Optional: CORS origins (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# Optional: Max file size in MB
MAX_FILE_SIZE_MB=5

# Optional: Rate limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
